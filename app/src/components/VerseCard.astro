---
import type { VersoUnido } from '../lib/types'

interface Props {
  verso: VersoUnido
  featured?: boolean
}

const { verso, featured = false } = Astro.props
const searchText = verso.searchText
---

<article
  data-verse-card
  data-search={searchText}
  data-has-note={verso.nota ? 'true' : 'false'}
  class:list={[
    featured
      ? 'overflow-hidden rounded-xl border border-line bg-[var(--color-card)] shadow-paper'
      : 'rounded-xl border border-line bg-[var(--color-card)] p-4 shadow-paper transition-shadow hover:shadow-paper-lg',
  ]}
>
  {featured ? <div class="h-1.5 bg-[var(--color-accent)]" /> : null}
  <div class={featured ? 'p-4' : undefined}>
    <div class:list={['flex flex-wrap items-center gap-2', featured ? undefined : 'mb-2']}>
      {
        featured ? (
          <span class="text-xs font-semibold text-[var(--color-accent)]">{verso.referencia}</span>
        ) : (
          <>
            <span class="rounded-md bg-[var(--color-accent-soft)] px-2 py-0.5 text-xs font-semibold text-[var(--color-accent)]">
              {verso.referencia}
            </span>
            <span class="text-xs text-[var(--color-muted)]">Cap. {verso.capitulo}</span>
          </>
        )
      }
      {
        verso.nota ? (
          <span class="rounded-md bg-[var(--color-note)] px-2 py-0.5 text-[10px] font-semibold text-[var(--color-note-text)]">
            Nota
          </span>
        ) : null
      }
    </div>
    <div class={featured ? undefined : 'space-y-3'}>
      {
        verso.traducciones.map((traduccion, index) => (
          <div
            class:list={[
              featured ? (index === 0 ? 'mt-2' : 'mt-3') : undefined,
              !featured && index > 0 ? 'border-t border-line-soft pt-3' : undefined,
            ]}
          >
            <p
              class:list={[
                featured
                  ? 'text-[10px] font-semibold uppercase tracking-wide'
                  : 'mb-1 text-[10px] font-semibold uppercase tracking-wide',
                traduccion.primary ? 'text-[var(--color-muted)]' : 'text-[var(--color-accent)]',
              ]}
            >
              {traduccion.etiqueta}
            </p>
            <p
              class:list={[
                featured ? 'mt-1 text-sm leading-relaxed' : 'text-sm leading-relaxed',
                traduccion.primary ? 'text-[var(--color-text)]' : 'text-[var(--color-text-soft)]',
              ]}
            >
              {traduccion.texto}
            </p>
          </div>
        ))
      }
    </div>
    {
      verso.nota ? (
        <div class="mt-3 rounded-lg border border-note-line bg-[var(--color-note)]/70 px-3 py-2.5">
          <p class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-[var(--color-note-text)]">
            Nota de estudio · RVR Esquematizada
          </p>
          <p class="text-sm leading-relaxed text-[var(--color-text)]">{verso.nota}</p>
        </div>
      ) : null
    }
  </div>
</article>
