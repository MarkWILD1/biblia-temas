---
import type { LibroCanon } from '../lib/types'
import { tonoDeGrupo } from '../lib/portadas'

interface Props {
  libro: LibroCanon
  grupoNombre: string
  meta?: string
  size?: 'sm' | 'md' | 'lg'
  class?: string
}

const { libro, grupoNombre, meta, size = 'md', class: className } = Astro.props
const tono = tonoDeGrupo(libro.grupo)
const publicado = libro.estado === 'publicado'
const Tag = publicado ? 'a' : 'div'
const largo = libro.nombre.length > 12
---

<Tag
  {...publicado ? { href: `/libros/${libro.slug}` } : {}}
  class:list={['cover', `cover--${size}`, publicado ? 'cover--live' : 'cover--soon', className]}
  style={`--cover-base:${tono.base};--cover-deep:${tono.deep}`}
  aria-label={publicado ? `Estudiar ${libro.nombre}` : `${libro.nombre}, próximamente`}
>
  <span class="cover__spine" aria-hidden="true"></span>
  <span class="cover__body">
    <span class="cover__mark" aria-hidden="true">A01</span>
    <span class="cover__title" data-largo={largo ? 'true' : undefined}>{libro.nombre}</span>
    <span class="cover__rule" aria-hidden="true"></span>
    <span class="cover__group">{grupoNombre}</span>
  </span>
  {
    publicado ? (
      meta ? (
        <span class="cover__meta">{meta}</span>
      ) : null
    ) : (
      <span class="cover__badge">Próximo</span>
    )
  }
</Tag>

<style>
  .cover {
    --cover-w: 9.5rem;
    position: relative;
    display: block;
    flex: none;
    width: var(--cover-w);
    aspect-ratio: 2 / 3;
    border-radius: 0.2rem 0.55rem 0.55rem 0.2rem;
    overflow: hidden;
    text-decoration: none;
    background:
      radial-gradient(120% 90% at 20% 0%, rgba(255, 253, 249, 0.22) 0%, rgba(255, 253, 249, 0) 55%),
      linear-gradient(160deg, var(--cover-base) 0%, var(--cover-deep) 100%);
    box-shadow:
      0 1px 2px rgba(84, 68, 40, 0.18),
      0 10px 22px -14px rgba(84, 68, 40, 0.5);
    transition:
      transform 180ms ease-out,
      box-shadow 180ms ease-out;
  }

  .cover--sm {
    --cover-w: 7rem;
  }

  .cover--lg {
    --cover-w: 12.5rem;
  }

  /* Trama de papel muy sutil sobre la tapa */
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      135deg,
      rgba(255, 253, 249, 0.05) 0px,
      rgba(255, 253, 249, 0.05) 1px,
      transparent 1px,
      transparent 4px
    );
    pointer-events: none;
  }

  .cover--live:hover,
  .cover--live:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 2px 4px rgba(84, 68, 40, 0.2),
      0 18px 34px -16px rgba(84, 68, 40, 0.55);
    outline: none;
  }

  .cover--soon {
    filter: saturate(0.35);
    opacity: 0.7;
  }

  .cover__spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.55rem;
    background: linear-gradient(
      90deg,
      rgba(28, 26, 23, 0.42) 0%,
      rgba(28, 26, 23, 0.16) 55%,
      rgba(255, 253, 249, 0.16) 100%
    );
  }

  .cover__body {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.35rem 0.9rem 1.35rem 1.4rem;
    text-align: center;
  }

  .cover__mark {
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: rgba(255, 253, 249, 0.55);
  }

  .cover__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #fffdf9;
    text-wrap: balance;
  }

  .cover__title[data-largo] {
    font-size: 1.05rem;
  }

  .cover--sm .cover__title {
    font-size: 1rem;
  }

  .cover--sm .cover__title[data-largo] {
    font-size: 0.85rem;
  }

  .cover--lg .cover__title {
    font-size: 1.75rem;
  }

  .cover--lg .cover__title[data-largo] {
    font-size: 1.4rem;
  }

  .cover__rule {
    width: 2.25rem;
    height: 3px;
    border-top: 1px solid rgba(255, 253, 249, 0.5);
    border-bottom: 1px solid rgba(255, 253, 249, 0.5);
  }

  .cover__group {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(255, 253, 249, 0.68);
  }

  .cover__meta,
  .cover__badge {
    position: absolute;
    z-index: 2;
    bottom: 0.55rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cover__meta {
    background: rgba(28, 26, 23, 0.3);
    color: rgba(255, 253, 249, 0.9);
  }

  .cover__badge {
    background: rgba(255, 253, 249, 0.86);
    color: #6b6455;
  }
</style>
