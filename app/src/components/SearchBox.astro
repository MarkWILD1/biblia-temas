---
import { Icon } from 'astro-icon/components'
---

<label class="relative block">
  <span class="sr-only">Buscar versículo o nota</span>
  <Icon
    name="ph:magnifying-glass"
    class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--color-muted)]"
  />
  <input
    type="search"
    data-verse-search
    placeholder="Buscar versículo o nota…"
    class="w-full rounded-full border border-line bg-[var(--color-card)] py-2 pl-10 pr-4 text-sm text-[var(--color-text)] outline-none transition placeholder:text-[var(--color-muted)] focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent-soft)]"
  />
</label>

<script>
  function wireVerseSearch() {
    const input = document.querySelector<HTMLInputElement>('[data-verse-search]')
    if (!input) return

    const empty = document.querySelector<HTMLElement>('[data-search-empty]')
    const results = document.querySelector<HTMLElement>('[data-search-results]')
    const count = document.querySelector<HTMLElement>('[data-search-count]')
    const noteCount = document.querySelector<HTMLElement>('[data-search-notes]')

    input.addEventListener('input', () => {
      const cards = [...document.querySelectorAll<HTMLElement>('[data-verse-card]')]
      const query = input.value.trim().toLowerCase()
      let visible = 0
      let notes = 0

      for (const card of cards) {
        const haystack = card.dataset.search ?? ''
        const show = query === '' || haystack.includes(query)
        card.hidden = !show
        if (show) {
          visible += 1
          if (card.dataset.hasNote === 'true') notes += 1
        }
      }

      if (count) count.textContent = String(visible)
      if (noteCount) noteCount.textContent = String(notes)
      if (empty) empty.hidden = visible !== 0
      if (results) results.hidden = visible === 0
    })
  }

  document.addEventListener('astro:page-load', wireVerseSearch)
</script>
