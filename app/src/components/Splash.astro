---
import LogoFlip from './LogoFlip.astro'
---

<div
  data-splash
  class="splash"
  role="status"
  aria-live="polite"
  aria-label="Cargando Arcanum01"
  transition:persist="a01-splash"
>
  <div class="splash-mark">
    <LogoFlip size="xl" />
    <p class="splash-name" data-splash-type>
      <span class="splash-name-sizer" aria-hidden="true">Arcanum01</span>
      <span class="splash-name-live">
        <span data-type-text></span><span class="splash-caret" data-type-caret></span>
      </span>
    </p>
  </div>
</div>

<noscript>
  <style>
    [data-splash] {
      display: none !important;
    }
    html {
      overflow: auto !important;
    }
  </style>
</noscript>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: var(--color-surface);
    user-select: none;
    overscroll-behavior: none;
    transition:
      opacity 520ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 520ms linear;
  }

  .splash.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .splash-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.15rem;
  }

  .splash-name {
    position: relative;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #1c1a17;
  }

  .splash-name-sizer {
    visibility: hidden;
    display: block;
  }

  .splash-name-live {
    position: absolute;
    inset: 0 auto auto 0;
    white-space: nowrap;
  }

  .splash-caret {
    display: inline-block;
    width: 0.085em;
    height: 0.92em;
    margin-left: 0.08em;
    vertical-align: -0.06em;
    background: #1c1a17;
    animation: splash-caret 0.86s steps(1) infinite;
  }

  .splash-caret.is-off {
    opacity: 0;
    animation: none;
  }

  @keyframes splash-caret {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 640px) {
    .splash-mark {
      gap: 1.55rem;
    }

    .splash-name {
      font-size: 1.85rem;
    }
  }
</style>

<script>
  function splashEl() {
    return document.querySelector<HTMLElement>('[data-splash]')
  }

  function announceSplashDone() {
    document.dispatchEvent(new CustomEvent('a01-splash-done'))
  }

  function unlock() {
    document.documentElement.dataset.splash = 'done'
    announceSplashDone()
  }

  function dismiss(splash: HTMLElement) {
    if (splash.classList.contains('is-done')) return
    splash.classList.add('is-done')
    splash.setAttribute('aria-hidden', 'true')
    splash.setAttribute('inert', '')

    window.setTimeout(() => {
      splash.hidden = true
      unlock()
    }, 560)
  }

  function init() {
    const splash = splashEl()
    if (!splash || splash.hidden || splash.classList.contains('is-done') || splash.dataset.wired) {
      return
    }
    if (document.documentElement.dataset.splash === 'done') {
      splash.hidden = true
      announceSplashDone()
      return
    }

    splash.dataset.wired = 'true'

    const WORD = 'Arcanum01'
    const logo = splash.querySelector<HTMLElement>('[data-logo-flip]')
    const typeTarget = splash.querySelector<HTMLElement>('[data-type-text]')
    const caret = splash.querySelector<HTMLElement>('[data-type-caret]')
    const fallback = window.setTimeout(() => dismiss(splash), 8000)

    let flipDone = logo?.dataset.flipState === 'done'
    let typeDone = false

    const maybeDismiss = () => {
      if (!flipDone || !typeDone) return
      window.clearTimeout(fallback)
      window.setTimeout(() => {
        caret?.classList.add('is-off')
        dismiss(splash)
      }, 520)
    }

    async function typeName() {
      if (!typeTarget) {
        typeDone = true
        maybeDismiss()
        return
      }

      await new Promise((resolve) => setTimeout(resolve, 280))

      for (const char of WORD) {
        typeTarget.textContent = (typeTarget.textContent ?? '') + char
        await new Promise((resolve) => setTimeout(resolve, 78))
      }

      typeDone = true
      maybeDismiss()
    }

    void typeName()

    if (flipDone) {
      maybeDismiss()
    } else {
      splash.addEventListener(
        'a01-flip-done',
        () => {
          flipDone = true
          maybeDismiss()
        },
        { once: true },
      )
    }
  }

  if (!document.documentElement.dataset.a01SplashWired) {
    document.documentElement.dataset.a01SplashWired = 'true'
    document.addEventListener('astro:page-load', init)
  }

  init()
</script>
